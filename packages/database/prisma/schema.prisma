generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum CompanyRole {
  ADMIN
  MANAGER
  STAFF
  GUEST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
}

enum ApprovalCategory {
  FINANCE
  PROCUREMENT
  HIRING
  MARKETING
  OPERATIONS
  LEGAL
}

enum ApprovalPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum NotificationPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum NotificationChannel {
  in_app
  email
  push
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  YOUTUBE
  TIKTOK
}

enum SocialPostStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  DELEGATE
  LOGIN
  LOGOUT
  VIEW
}

enum MessageSource {
  EMAIL
  WHATSAPP
  LINKEDIN
  INSTAGRAM
  TIKTOK
  FACEBOOK
  INTERNAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ─── GLOBAL MODELS ────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  avatar        String?
  globalRole    GlobalRole @default(USER)
  password      String?
  status        String     @default("active")
  inviteToken   String?    @unique
  inviteExpires DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMembership[]
  tasks         Task[]              @relation("TaskAssignee")
  createdTasks  Task[]              @relation("TaskCreator")
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  logo        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships CompanyMembership[]
  tasks       Task[]
  notifications Notification[]
  bookings    Booking[]
  workflowRuns WorkflowRun[]
  auditLogs   AuditLog[]
  embeddings  VectorEmbedding[]

  @@map("companies")
}

model CompanyMembership {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole @default(STAFF)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("company_memberships")
}

// ─── FEATURE MODELS (all company-scoped) ──────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  companyId   String
  title       String
  description String?
  assigneeId  String?
  creatorId   String
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company     Company @relation(fields: [companyId], references: [id])
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User    @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([companyId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Approval {
  id            String           @id @default(cuid())
  companyId     String
  category      ApprovalCategory
  title         String
  description   String           @db.Text
  amount        Float?
  currency      String           @default("XAF")
  requestedBy   String
  requestedAt   DateTime         @default(now())
  status        ApprovalStatus   @default(PENDING)
  priority      ApprovalPriority @default(NORMAL)
  n8nWorkflow   String?
  aiAnalysis    String?          @db.Text
  aiRisk        String?
  decidedAt     DateTime?
  decidedBy     String?
  delegatedTo   String?
  rejectionNote String?
  auditLog      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, priority, requestedAt])
  @@index([companyId, status])
  @@map("approvals")
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  companyId String?
  type      String
  title     String
  body      String
  data      Json?
  priority  NotificationPriority @default(NORMAL)
  channel   NotificationChannel  @default(in_app)
  read      Boolean              @default(false)
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SocialPost {
  id          String           @id @default(cuid())
  companyId   String
  platform    SocialPlatform
  content     String
  mediaUrls   String[]
  status      SocialPostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId, status])
  @@index([scheduledAt])
  @@map("social_posts")
}

model Booking {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  hostId      String
  guestEmail  String?
  guestName   String?
  startAt     DateTime
  endAt       DateTime
  status      String   @default("confirmed")
  notes       String?
  meetingUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company @relation(fields: [companyId], references: [id])

  @@index([companyId, startAt])
  @@map("bookings")
}

model WorkflowRun {
  id              String   @id @default(cuid())
  companyId       String
  n8nWorkflowId   String
  n8nWorkflowName String?
  triggeredBy     String?
  status          String   @default("running")
  result          Json?
  error           String?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?

  company         Company @relation(fields: [companyId], references: [id])

  @@index([companyId, startedAt])
  @@map("workflow_runs")
}

model AuditLog {
  id          String      @id @default(cuid())
  companyId   String?
  userId      String?
  action      AuditAction
  resource    String
  resourceId  String?
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  company     Company? @relation(fields: [companyId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model VectorEmbedding {
  id           String   @id @default(cuid())
  companyId    String
  content      String   @db.Text
  embedding    Unsupported("vector(1536)")?
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  company      Company @relation(fields: [companyId], references: [id])

  @@index([companyId, resourceType])
  @@map("vector_embeddings")
}

// ─── COMMUNICATIONS ───────────────────────────────────────────────────────────

model Message {
  id          String           @id @default(cuid())
  externalId  String?          @unique
  companyId   String
  source      MessageSource
  direction   MessageDirection @default(INBOUND)
  fromName    String
  fromHandle  String?
  fromAvatar  String?
  subject     String?
  body        String           @db.Text
  bodyHtml    String?          @db.Text
  receivedAt  DateTime
  isRead      Boolean          @default(false)
  isArchived  Boolean          @default(false)
  isStarred   Boolean          @default(false)
  aiSummary   String?          @db.Text
  aiDraft     String?          @db.Text
  aiActToday  Boolean          @default(false)
  delegatedTo String?
  threadId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId, source, receivedAt])
  @@index([isRead, aiActToday])
  @@map("messages")
}

// ─── CALENDAR ─────────────────────────────────────────────────────────────────

enum EventType {
  MEETING
  CALL
  CONFERENCE
  INTERNAL
  PERSONAL
  TRAVEL
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Event {
  id          String      @id @default(cuid())
  companyId   String?
  title       String
  description String?
  type        EventType   @default(MEETING)
  status      EventStatus @default(CONFIRMED)
  startAt     DateTime
  endAt       DateTime
  location    String?
  attendees   String[]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([startAt, status])
  @@map("events")
}

model BookingRequest {
  id             String        @id @default(cuid())
  companyId      String?
  requesterName  String
  requesterEmail String
  requesterPhone String?
  purpose        String
  requestedDate  DateTime
  duration       Int
  status         BookingStatus @default(PENDING)
  declinedReason String?
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, requestedDate])
  @@map("booking_requests")
}

// ─── VENTURE REPORTS ─────────────────────────────────────────────────────────

model VentureReport {
  id            String    @id @default(cuid())
  venture       String
  ventureName   String
  type          String    // 'report' | 'incident' | 'update' | 'approval_request'
  urgency       String    @default("normal") // 'normal' | 'urgent' | 'critical'
  title         String
  body          String    @db.Text
  submittedBy   String
  submittedVia  String    @default("form") // 'form' | 'telegram'
  status        String    @default("new") // 'new' | 'acknowledged' | 'in_review' | 'resolved'
  ceoReply      String?   @db.Text
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([venture])
  @@index([status])
  @@index([urgency])
  @@index([createdAt])
  @@map("venture_reports")
}

// ─── ROGERS REGISTRATIONS ─────────────────────────────────────────────────────

model RogersRegistration {
  id                   String    @id @default(cuid())
  reference            String    @unique
  program              String
  programName          String
  amount               Int
  currency             String    @default("XAF")
  status               String    @default("initiated") // initiated | confirmed | failed
  payunitTransactionId String?
  registrantName       String?
  registrantEmail      String?
  registrantPhone      String?
  source               String?
  createdAt            DateTime  @default(now())
  confirmedAt          DateTime?

  @@index([program, status, createdAt])
  @@map("rogers_registrations")
}

// ─── EXECUTIVE BRIEFING CENTRE ───────────────────────────────────────────────
// Additive module (2026-10-24). Design: apps/executive-os/docs/briefing-centre/ARCHITECTURE.md
// - Every row carries isDemo. Demo and live rows are never read together: each query
//   filters on the deployment's briefing mode (lib/briefing/mode.ts).
// - ExecRecord is a source-linked read model (sourceSystem + sourceRef), not a ledger:
//   NMI / Odoo / web forms stay the system of record; MGI never posts accounting entries.
// - Status fields are strings validated in code (no new enums: additive db push only).

model ExecRecord {
  id           String    @id @default(cuid())
  ref          String    @unique
  companySlug  String
  domain       String
  recordType   String
  title        String
  summary      String?   @db.Text
  status       String
  execStatus   String    @default("NEW") // NEW | ACKNOWLEDGED | ACTION_REQUESTED | CLOSED
  amount       Float?
  currency     String?
  occurredAt   DateTime
  dueAt        DateTime?
  sourceSystem String
  sourceRef    String?
  parentRef    String?
  data         Json?
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isDemo, companySlug, recordType, occurredAt])
  @@index([parentRef])
  @@map("exec_records")
}

model ExecMeeting {
  id          String   @id @default(cuid())
  ref         String   @unique
  companySlug String
  title       String
  heldAt      DateTime
  chair       String
  attendees   String[]
  agenda      String[]
  minutes     String   @db.Text
  summary     String?  @db.Text
  documents   Json?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions   ExecDecision[]

  @@index([isDemo, heldAt])
  @@map("exec_meetings")
}

model ExecDecision {
  id          String   @id @default(cuid())
  ref         String   @unique
  meetingId   String
  companySlug String
  text        String   @db.Text
  rationale   String?  @db.Text
  status      String   @default("OPEN") // OPEN | IMPLEMENTED | SUPERSEDED
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting     ExecMeeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  commitments ExecCommitment[]

  @@index([meetingId])
  @@map("exec_decisions")
}

model ExecCommitment {
  id          String    @id @default(cuid())
  ref         String    @unique
  companySlug String
  decisionId  String?
  recordId    String?   // ExecRecord that prompted the action, when there is one
  title       String
  deliverable String    @db.Text
  ownerName   String
  ownerRole   String
  committedAt DateTime
  dueAt       DateTime
  progress    Int       @default(0)
  status      String    @default("OPEN") // OPEN | IN_PROGRESS | BLOCKED | DELIVERED | ACCEPTED | CANCELLED
  blocker     String?   @db.Text
  delayCause  String?   // OWNER | RESOURCES | PRIORITY_CHANGE | MANAGEMENT_DEPENDENCY | EXTERNAL
  deliveredAt DateTime?
  evidence    String?   @db.Text
  acceptedBy  String?
  acceptedAt  DateTime?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  decision    ExecDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([isDemo, companySlug, status, dueAt])
  @@index([decisionId])
  @@map("exec_commitments")
}

model ExecActivity {
  id          String   @id @default(cuid())
  subjectType String   // RECORD | COMMITMENT | DECISION | MEETING
  subjectId   String
  action      String
  fromStatus  String?
  toStatus    String?
  note        String?  @db.Text
  actor       String
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([subjectType, subjectId, createdAt])
  @@map("exec_activities")
}

model ExecEvent {
  id             String    @id @default(cuid())
  dedupeKey      String    @unique
  companySlug    String
  domain         String
  kind           String
  priority       String    // CRITICAL | HIGH | NORMAL | LOW
  subject        String
  summary        String    @db.Text
  facts          Json?
  actionRequired String?
  subjectType    String    // RECORD | COMMITMENT | MEETING
  subjectId      String
  isDemo         Boolean   @default(false)
  occurredAt     DateTime
  routing        String?   // ALERT | DIGEST — set when processed
  processedAt    DateTime?
  digestedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([isDemo, processedAt])
  @@index([isDemo, routing, digestedAt])
  @@map("exec_events")
}

model ExecNotification {
  id                String    @id @default(cuid())
  dedupeKey         String    @unique
  kind              String    // ALERT | DIGEST | MORNING_BRIEF
  recipient         String    // recipient key from lib/briefing/recipients.ts — never a chat id
  eventIds          String[]
  text              String    @db.Text
  linkUrl           String?
  status            String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | DRY_RUN
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lastError         String?
  telegramMessageId String?
  isDemo            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([isDemo, status, nextAttemptAt])
  @@index([recipient, kind, createdAt])
  @@map("exec_notifications")
}
