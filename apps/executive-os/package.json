{
  "name": "executive-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:env:check": "node scripts/test-env/assert-test-db.mjs",
    "test:env:start": "node scripts/test-env/start-test-server.mjs --build",
    "test:env:seed": "tsx scripts/test-env/fixtures.ts seed",
    "test:env:cleanup": "tsx scripts/test-env/fixtures.ts cleanup",
    "test:integration": "node scripts/test-env/run-integration.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@mgi/auth": "workspace:*",
    "@mgi/database": "workspace:*",
    "@mgi/types": "workspace:*",
    "@mgi/ui": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "date-fns": "^4.1.0",
    "next": "^16.2.4",
    "next-auth": "beta",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@mgi/config": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
